{
  "hosting": [
    {
      "site": "barangay-malineng",
      "public": "out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "redirects": [
        {
          "regex": "^/(?P<path>.*?)/?index\\.txt/$",
          "destination": "/:path",
          "type": 301
        }
      ]
    },
    {
      "site": "project-a682ecac-e2d1-469c-bc7",
