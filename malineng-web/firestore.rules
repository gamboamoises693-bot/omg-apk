rules_version = '2';

// =====================================================================
// Barangay Malineng - Firestore Security Rules
// - Guests (not logged in): read-only on public content
// - Residents: can create posts/listings/etc. (status always "pending")
// - Admins: users/{uid}.role == "admin" (+ position, e.g. "Kapitan", "Secretary")
// - Super Admin: users/{uid}.role == "superadmin" (sees everything, manages roles,
//   reads the activity log). Set the FIRST super admin manually in Firebase Console.
// - Verified residents: verifiedUsers/{uid} exists (selfie approved by an admin).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(myDocPath()).data;
    }

    function hasProfile() {
      return signedIn() && exists(myDocPath());
    }

    // Staff = any admin account, including BHW.
    function isStaff() {
      return hasProfile() && me().role in ['admin', 'superadmin'];
    }

    // Full admin powers. A BHW (or BHW Head) is staff but only manages the Botika.
    function isAdmin() {
      return isStaff() && !(me().get('position', '') in ['BHW', 'BHW Head']);
    }

    // Botika (medicine inventory): BHW, BHW Head, Kapitan and the Super Admin.
    function isBotika() {
      return isSuperAdmin() || (isStaff() && me().get('position', '') in ['BHW', 'BHW Head', 'Kapitan']);
    }

    // Hiraman (borrowing barangay equipment): Kapitan, Secretary and the Super Admin approve.
    function isBorrowAdmin() {
      return isSuperAdmin() || (isAdmin() && me().get('position', '') in ['Kapitan', 'Secretary']);
    }

    // Officers: Kapitan, Secretary and the Super Admin (Pabatid, Survey, Transparency, Blotter...).
    function isOfficer() {
      return isBorrowAdmin();
    }

    // Liga ng barangay: officers + SK Chairman.
    function isLiga() {
      return isOfficer() || (isAdmin() && me().get('position', '') == 'SK Chairman');
    }

    function isSuperAdmin() {
      return hasProfile() && me().role == 'superadmin';
    }

    // Ambulance releases: Kapitan (and the Super Admin).
    function isKapitan() {
      return isSuperAdmin() || (isAdmin() && me().get('position', '') == 'Kapitan');
    }

    // ---- Configurable approval (Hiraman, Hiraman return, Ambulansya) ----
    // The Developer sets, per action, which positions approve in order (settings/approvals).
    // Default: Secretary -> Kapitan. While a request is 'pending', `stage` (missing = 0) says whose turn it is.
    // The Developer can always act at any stage. BHW is never an approver.
    function approvalCfg(key) {
      return exists(/databases/$(database)/documents/settings/approvals)
          && get(/databases/$(database)/documents/settings/approvals).data.get('actions', {}).get(key, null) != null
        ? get(/databases/$(database)/documents/settings/approvals).data.actions[key]
        : {'on': true, 'steps': ['Secretary', 'Kapitan'], 'fast': key == 'ambe', 'fastBy': 'Kapitan'};
    }

    // With approval switched off a single decider (the first step) is enough.
    function stepsOf(key) {
      return approvalCfg(key).get('on', true) == true ? approvalCfg(key).steps : approvalCfg(key).steps[0:1];
    }

    function stepMatches(step) {
      return isSuperAdmin() || (isAdmin() && (step == 'Sinumang Admin' || me().get('position', '') == step));
    }

    function mayActAt(key, stage) {
      return stage >= 0 && stage < stepsOf(key).size() && stepMatches(stepsOf(key)[stage]);
    }

    // Exactly one new log entry per change, so nobody can erase the trail.
    function trailGrewByOne() {
      return incoming().trail is list
        && incoming().trail.size() == existing().get('trail', []).size() + 1;
    }

    // After release nobody except the Developer may touch the approval log.
    function trailUntouched() {
      return !incoming().diff(existing()).affectedKeys().hasAny(['trail', 'stage', 'urgent', 'returnStage', 'returnTrail']);
    }

    function approvalFieldsOnly() {
      return incoming().diff(existing()).affectedKeys().hasOnly(
        ['status', 'stage', 'trail', 'urgent', 'rejectReason', 'decidedBy', 'decidedByName', 'decidedAt', 'updatedAt', 'driver', 'durationHours', 'adminNote']);
    }

    // The emergency "agaran" release: only if the Developer allowed it for this action, by the chosen position.
    function mayFast(key) {
      return isSuperAdmin()
        || (approvalCfg(key).get('fast', false) == true && isAdmin()
          && (approvalCfg(key).get('fastBy', 'Kapitan') == 'Kapitan' ? me().get('position', '') == 'Kapitan'
            : approvalCfg(key).get('fastBy', 'Kapitan') == 'Secretary' ? me().get('position', '') == 'Secretary'
            : me().get('position', '') in ['Kapitan', 'Secretary']));
    }

    function approvalMove(key) {
      return existing().status == 'pending' && trailGrewByOne() && approvalFieldsOnly()
        && (
          // forward to the next approver
          (incoming().status == 'pending' && existing().get('stage', 0) < stepsOf(key).size() - 1
            && incoming().stage == existing().get('stage', 0) + 1 && mayActAt(key, existing().get('stage', 0)))
          // back one step, with a reason in the trail
          || (incoming().status == 'pending' && existing().get('stage', 0) > 0
            && incoming().stage == existing().get('stage', 0) - 1 && mayActAt(key, existing().get('stage', 0)))
          // the last approver releases
          || (incoming().status == 'approved' && existing().get('stage', 0) >= stepsOf(key).size() - 1
            && mayActAt(key, stepsOf(key).size() - 1))
          // the approver whose turn it is may reject
          || (incoming().status == 'rejected'
            && mayActAt(key, existing().get('stage', 0) < stepsOf(key).size() ? existing().get('stage', 0) : stepsOf(key).size() - 1))
          // emergency release
          || (incoming().status == 'approved' && incoming().get('urgent', false) == true && mayFast(key))
        );
    }

    // ---- Hiraman return: the borrower (or staff for them) hands back; the approvers of 'balik' accept in order ----
    function returnStageNow() {
      return existing().get('returnStage', -1);
    }

    function returnTrailGrew() {
      return incoming().returnTrail is list
        && incoming().returnTrail.size() == existing().get('returnTrail', []).size() + 1;
    }

    function returnStart() {
      return existing().status == 'borrowed' && returnStageNow() == -1
        && returnTrailGrew() && incoming().status == 'borrowed' && incoming().returnStage == 0
        && incoming().diff(existing()).affectedKeys().hasOnly(['returnStage', 'returnTrail', 'updatedAt'])
        && ((signedIn() && existing().userId == request.auth.uid) || isBorrowAdmin());
    }

    function returnMove() {
      return existing().status == 'borrowed' && returnStageNow() >= 0 && returnTrailGrew()
        && incoming().diff(existing()).affectedKeys().hasOnly(
          ['returnStage', 'returnTrail', 'returnReport', 'returnNote', 'damageFee', 'feeStatus', 'status', 'returnedAt', 'returnedToName', 'updatedAt'])
        && (
          (incoming().status == 'borrowed' && returnStageNow() < stepsOf('balik').size() - 1
            && incoming().returnStage == returnStageNow() + 1 && mayActAt('balik', returnStageNow()))
          || (incoming().status == 'borrowed' && returnStageNow() > 0
            && incoming().returnStage == returnStageNow() - 1 && mayActAt('balik', returnStageNow()))
          // sent back to the borrower (not complete)
          || (incoming().status == 'borrowed' && incoming().returnStage == -1 && mayActAt('balik', returnStageNow()))
          // the last approver accepts and closes
          || (incoming().status == 'returned' && returnStageNow() >= stepsOf('balik').size() - 1
            && mayActAt('balik', stepsOf('balik').size() - 1))
        );
    }

    function notSuspended() {
      return hasProfile() && me().get('suspended', false) != true;
    }

    // Admins count as verified.
    function isVerified() {
      return signedIn()
        && (exists(/databases/$(database)/documents/verifiedUsers/$(request.auth.uid)) || isStaff());
    }

    function verifiedPoster() {
      return isVerified() && notSuspended();
    }

    function incoming() {
      return request.resource.data;
    }

    // Email/password accounts must confirm their email before posting or sending a selfie.
    // Google accounts are already confirmed; staff are exempt (accounts made by the Super Admin).
    function emailOk() {
      return request.auth.token.email_verified == true || isStaff();
    }

    // Chat rooms: "all" (whole barangay), the exact Purok name, and two private staff rooms.
    // Verified residents read the barangay room and their own Purok; staff read every public room.
    // 'staff-admin' = every admin account (BHW included); 'staff-officials' = admins without BHW,
    // which includes the Developer (Super Admin). Residents can never read either, even with a Purok
    // named like them, because the staff rooms are matched first.
    function canReadRoom(room) {
      return room == 'staff-admin' ? (isStaff() && notSuspended())
        : room == 'staff-officials' ? (isAdmin() && notSuspended())
        : verifiedPoster() && (room == 'all' || room == me().get('purok', '') || isStaff());
    }

    function chatMuted() {
      return exists(/databases/$(database)/documents/chatMutes/$(request.auth.uid))
        && get(/databases/$(database)/documents/chatMutes/$(request.auth.uid)).data.until > request.time;
    }

    function chatOpen() {
      return !exists(/databases/$(database)/documents/settings/chat)
        || get(/databases/$(database)/documents/settings/chat).data.get('enabled', true) == true;
    }

    function chatPhotosOpen() {
      return !exists(/databases/$(database)/documents/settings/chat)
        || get(/databases/$(database)/documents/settings/chat).data.get('photos', true) == true;
    }

    function existing() {
      return resource.data;
    }

    function changedOnly(fields) {
      return incoming().diff(existing()).affectedKeys().hasOnly(fields);
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Purok list is managed by the admin in Settings, so only check shape here.
    function validPurok(p) {
      return isNonEmptyString(p, 40);
    }

    function optionalPhoto() {
      // photoURL is either empty, a Storage URL, or a small compressed data URL.
      return incoming().photoURL is string && incoming().photoURL.size() < 900000;
    }

    // ---------- users ----------
    // One mobile number = one account: a non-empty contact must be a normalized PH mobile
    // number whose phoneIndex entry (written in the same batch) belongs to this user.
    function contactOk(uid) {
      return !('contact' in incoming())
        || incoming().contact == ''
        || (incoming().contact is string
          && incoming().contact.matches('^09[0-9]{9}$')
          && getAfter(/databases/$(database)/documents/phoneIndex/$(incoming().contact)).data.uid == uid);
    }

    match /phoneIndex/{phone} {
      // Lets the app tell "this number is taken" (a denied read on someone else's number).
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSuperAdmin();
      // Claimed only together with the user's contact; never moved to another user.
      allow create: if phone.matches('^09[0-9]{9}$')
        && incoming().keys().hasOnly(['uid', 'createdAt'])
        && (incoming().uid == request.auth.uid || isSuperAdmin())
        && getAfter(/databases/$(database)/documents/users/$(incoming().uid)).data.contact == phone;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    // Duplicate groups the Super Admin marked "hindi doble".
    match /duplicateDismissed/{key} {
      allow read, write: if isSuperAdmin();
    }

    match /users/{uid} {
      // BHW reads users to look up the resident receiving medicine.
      allow read: if isSelf(uid) || isAdmin() || isBotika();
      allow create: if isSelf(uid)
        && incoming().role == 'resident'
        && incoming().keys().hasOnly(['uid', 'fullName', 'purok', 'contact', 'birthday', 'email', 'role', 'createdAt'])
        && isNonEmptyString(incoming().fullName, 120)
        && contactOk(uid)
        // The Super Admin can also create accounts for officials (Kapitan, Secretary, BHW...).
        || (isSuperAdmin()
          && incoming().role in ['resident', 'admin']
          && incoming().keys().hasOnly(['uid', 'fullName', 'purok', 'contact', 'birthday', 'email', 'role', 'position', 'createdAt', 'createdBy'])
          && incoming().uid == uid
          && isNonEmptyString(incoming().fullName, 120)
          && contactOk(uid));
      // A user edits their own profile but never role, position or suspension.
      // Only the Super Admin manages roles, and cannot demote themself (avoids lock-out).
      // Profile photo (photoURL) is for staff (admins and BHW) only.
      allow update: if (isSelf(uid)
          && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'position', 'suspended'])
          && (!incoming().diff(existing()).affectedKeys().hasAny(['photoURL'])
              || (isStaff() && incoming().photoURL is string && incoming().photoURL.size() < 60000))
          && (!incoming().diff(existing()).affectedKeys().hasAny(['contact']) || contactOk(uid)))
        || (isSuperAdmin() && !(isSelf(uid) && incoming().role != 'superadmin'));
      allow delete: if isSelf(uid) || isSuperAdmin();
    }

    // ---------- Botika (medicine inventory; BHW) ----------
    function validMedicine() {
      return isNonEmptyString(incoming().name, 80)
        && incoming().form is string
        && incoming().stock is int && incoming().stock >= 0 && incoming().stock <= 1000000
        && incoming().minStock is int && incoming().minStock >= 0;
    }

    match /medicines/{id} {
      allow read: if isBotika();
      // Stock can never go below zero, even with two BHWs giving at the same time.
      allow create, update: if isBotika() && validMedicine();
      allow delete: if isBotika();
    }

    // Append-only movement log: dispense / restock / dispose.
    match /medicineLogs/{id} {
      allow read: if isBotika();
      allow create: if isBotika()
        && incoming().byId == request.auth.uid
        && incoming().type in ['dispense', 'restock', 'dispose']
        && incoming().items is list && incoming().items.size() > 0 && incoming().items.size() <= 20
        && incoming().medicineIds is list
        && isNonEmptyString(incoming().byName, 120);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Public "available / ubos" list (no exact counts) for residents.
    match /botikaPublic/{id} {
      allow read: if true;
      allow write: if isBotika();
    }

    // ---------- Hiraman (borrowing barangay equipment) ----------
    match /borrowItems/{id} {
      allow read: if true;
      allow create, update: if isBorrowAdmin()
        && isNonEmptyString(incoming().name, 80)
        && incoming().total is int && incoming().total >= 0 && incoming().total <= 100000
        && incoming().maxPerBorrow is int && incoming().maxPerBorrow >= 1
        && incoming().fee is number && incoming().fee >= 0
        // Units that came back broken: out of use, but still part of the total.
        && incoming().get('damaged', 0) is int && incoming().get('damaged', 0) >= 0 && incoming().get('damaged', 0) <= incoming().total
        && incoming().photo is string && incoming().photo.size() < 150000;
      // The approver who accepts a return may mark units damaged or lost (and nothing else on the item).
      allow update: if isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['total', 'damaged'])
        && incoming().total is int && incoming().total >= 0
        && incoming().get('damaged', 0) is int && incoming().get('damaged', 0) >= 0 && incoming().get('damaged', 0) <= incoming().total;
      allow delete: if isBorrowAdmin();
    }

    function validBorrowRequest() {
      return incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().items is list && incoming().items.size() > 0 && incoming().items.size() <= 10
        && incoming().itemIds is list && incoming().itemIds.size() == incoming().items.size()
        && incoming().start is timestamp && incoming().end is timestamp
        && incoming().end > incoming().start
        && isNonEmptyString(incoming().userName, 120)
        && isNonEmptyString(incoming().purpose, 80)
        && incoming().note is string && incoming().note.size() <= 300
        && incoming().keys().hasOnly(['userId', 'userName', 'purok', 'contact', 'items', 'itemIds', 'start', 'end', 'purpose', 'note', 'status', 'createdAt']);
    }

    match /borrowRequests/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      // Verified, not suspended residents only.
      allow create: if verifiedPoster() && validBorrowRequest();
      // The borrower can only cancel while still waiting.
      allow update: if (signedIn() && existing().userId == request.auth.uid
          && existing().status == 'pending'
          && incoming().status == 'cancelled'
          && changedOnly(['status']))
        // Once released, Kapitan / Secretary handle pick-up and return. Before that, only the approval steps apply.
        || (existing().status != 'pending' && isBorrowAdmin() && trailUntouched()
            && !(existing().status == 'borrowed' && incoming().status == 'returned'))
        || approvalMove('hiram')
        || returnStart()
        || returnMove()
        || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Public reservations (no names/contacts) so anyone can see what is available on a date.
    match /borrowBookings/{id} {
      allow read: if true;
      // Public reservation (no personal info). Any approver releases or closes a request.
      allow write: if isAdmin();
    }

    // ---------- verifications (selfie; private to owner + admins) ----------
    match /verifications/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Owner submits / re-submits (not after being verified). Kept until the account is deleted.
      allow create, update: if isSelf(uid)
        && notSuspended()
        && emailOk()
        && (resource == null || existing().status != 'verified')
        && incoming().keys().hasOnly(['uid', 'fullName', 'purok', 'birthday', 'contact', 'email', 'selfie', 'status', 'submittedAt'])
        && incoming().uid == uid
        && incoming().status == 'pending'
        && incoming().selfie is string && incoming().selfie.size() < 400000
        && incoming().submittedAt == request.time;
      // The Super Admin can replace the photo that is printed on a Barangay ID (e.g. a dark or blurry selfie).
      allow update: if isSuperAdmin() && changedOnly(['selfie'])
        && incoming().selfie is string && incoming().selfie.size() > 0 && incoming().selfie.size() < 400000;
      // Admin review.
      allow update: if isAdmin()
        && (existing().uid != request.auth.uid || isSuperAdmin())
        && changedOnly(['status', 'reason', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
        && incoming().status in ['pending', 'verified', 'rejected'];
      allow delete: if isSelf(uid) || isSuperAdmin();
    }

    // ---------- verifiedUsers (public flag: doc exists = verified; for badges) ----------
    match /verifiedUsers/{uid} {
      // One person by id (ID check, own status): public. The whole list is for admins only, so
      // nobody can download the names of every verified resident (badges read stats/verifiedSet).
      allow get: if true;
      allow list: if isAdmin();
      // An admin verifies other people; only the Super Admin may verify their own account.
      allow create, update: if isAdmin() && (request.auth.uid != uid || isSuperAdmin());
      allow delete: if isAdmin() || isSelf(uid);
    }

    // ---------- activityLogs (append-only; Super Admin reads) ----------
    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn()
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time
        && isNonEmptyString(incoming().type, 40)
        && isNonEmptyString(incoming().text, 500);
      allow update, delete: if false;
    }

    // ---------- issuedDocuments (printable clearance; public QR check) ----------
    match /issuedDocuments/{docId} {
      // Anyone with the document number can verify it; the full list is for admins only.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- households (census; owner + admins) ----------
    match /households/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && notSuspended()
        && incoming().members is list && incoming().members.size() <= 20
        && validPurok(incoming().purok);
      allow delete: if isSelf(uid) || isSuperAdmin();
    }

    // ---------- posts (Community Board) ----------
    match /posts/{postId} {
      allow read: if existing().status == 'approved'
        || isAdmin()
        || (signedIn() && existing().authorId == request.auth.uid);

      allow create: if notSuspended() && emailOk()
        && incoming().authorId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().likes.size() == 0
        && incoming().get('reactions', {}).size() == 0
        && isNonEmptyString(incoming().content, 3000)
        && optionalPhoto();

      // Reactions: a resident may only add/remove/change THEIR OWN uid in "likes" (everyone who reacted)
      // and in "reactions" (uid -> 'like' | 'love' | 'haha' | 'wow' | 'sad' | 'pray').
      allow update: if isAdmin()
        || (signedIn()
          && existing().status == 'approved'
          && changedOnly(['likes', 'reactions'])
          && incoming().likes.toSet().difference(existing().likes.toSet())
               .union(existing().likes.toSet().difference(incoming().likes.toSet()))
               .hasOnly([request.auth.uid])
          && incoming().get('reactions', {}).diff(existing().get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in incoming().get('reactions', {}))
              || incoming().reactions[request.auth.uid] in ['like', 'love', 'haha', 'wow', 'sad', 'pray']));

      allow delete: if isAdmin() || (signedIn() && existing().authorId == request.auth.uid);
    }

    // ---------- comments ----------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if notSuspended() && emailOk()
        && incoming().authorId == request.auth.uid
        && isNonEmptyString(incoming().text, 1000)
        && get(/databases/$(database)/documents/posts/$(incoming().postId)).data.status == 'approved';
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && existing().authorId == request.auth.uid);
    }

    // ---------- listings (Tindahan) ----------
    match /listings/{listingId} {
      // Contact numbers are inside, so only signed-in people can read listings.
      allow read: if signedIn() && (existing().status == 'approved'
        || isAdmin()
        || existing().sellerId == request.auth.uid);

      allow create: if verifiedPoster()
        && incoming().sellerId == request.auth.uid
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().title, 120)
        && incoming().price is number && incoming().price >= 0
        // A listed category, or one the seller wrote when choosing "Iba pa" (an admin approves every listing).
        && isNonEmptyString(incoming().category, 40)
        && incoming().expiresAt is timestamp
        && optionalPhoto();

      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && existing().sellerId == request.auth.uid);
    }

    // ---------- listingPhotos (full-size photo; the listing itself keeps a small thumbnail) ----------
    match /listingPhotos/{listingId} {
      allow read: if true;
      allow create: if verifiedPoster()
        && incoming().sellerId == request.auth.uid
        && incoming().photo is string && incoming().photo.size() < 900000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && existing().sellerId == request.auth.uid);
    }

    // ---------- jobs (Trabaho) ----------
    match /jobs/{jobId} {
      allow read: if signedIn() && (existing().status == 'approved'
        || isAdmin()
        || existing().posterId == request.auth.uid);
      allow create: if verifiedPoster()
        && incoming().posterId == request.auth.uid
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().title, 120);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && existing().posterId == request.auth.uid);
    }

    // ---------- Hiring: job openings + applications ----------
    function validOpening() {
      return isNonEmptyString(incoming().title, 120)
        && incoming().employer is string && incoming().employer.size() <= 80
        && incoming().slots is int && incoming().slots >= 1 && incoming().slots <= 500
        && incoming().filled == 0
        && incoming().type in ['Full-time', 'Part-time', 'Pana-panahon']
        && incoming().salary is string && incoming().salary.size() <= 60
        && incoming().deadline is string && incoming().deadline.size() <= 10
        && incoming().requirements is list && incoming().requirements.size() <= 10
        && incoming().details is string && incoming().details.size() <= 500
        && incoming().purok is string && incoming().purok.size() <= 40
        && incoming().contact is string && incoming().contact.size() <= 30
        && incoming().applyMode in ['website', 'contact', 'link']
        // Where the job is (any place, not only Malineng) and an optional company website.
        && incoming().get('location', '') is string && incoming().get('location', '').size() <= 100
        && incoming().get('applyUrl', '') is string && incoming().get('applyUrl', '').size() <= 300
        && (incoming().get('applyUrl', '') == '' || incoming().get('applyUrl', '').matches('^https?://[^ ]+$'))
        && (incoming().applyMode != 'link' || incoming().get('applyUrl', '') != '')
        && incoming().get('resumeRequired', false) is bool
        && incoming().state == 'open';
    }

    match /openings/{id} {
      allow read: if signedIn() && (resource.data.status == 'approved'
        || isAdmin()
        || resource.data.posterId == request.auth.uid);
      allow create: if validOpening() && incoming().posterId == request.auth.uid && (
        // Verified residents wait for approval; the Barangay officers publish "OPISYAL" openings directly.
        (verifiedPoster() && incoming().status == 'pending' && incoming().official == false)
        || (isOfficer() && incoming().status == 'approved' && incoming().official == true));
      // The poster can only close / reopen and update how many were hired; admins can change anything.
      allow update: if isAdmin()
        || (signedIn() && existing().posterId == request.auth.uid && existing().status == 'approved'
          && changedOnly(['state', 'filled'])
          && incoming().state in ['open', 'full', 'closed']
          && incoming().filled is int && incoming().filled >= 0 && incoming().filled <= existing().slots);
      allow delete: if isAdmin() || (signedIn() && existing().posterId == request.auth.uid);
    }

    // Private: the applicant, the employer who posted the opening, and the officers (Kapitan, Secretary, Super Admin).
    match /applications/{appId} {
      allow read: if (signedIn() && (resource.data.applicantId == request.auth.uid || resource.data.employerId == request.auth.uid))
        || isOfficer();
      // One application per person per opening (the id carries both), only while the opening is taking applications.
      allow create: if verifiedPoster()
        && incoming().applicantId == request.auth.uid
        && appId == incoming().openingId + '_' + request.auth.uid
        && incoming().status == 'new'
        && incoming().keys().hasOnly(['openingId', 'openingTitle', 'employerId', 'applicantId', 'applicantName', 'purok', 'contact', 'age', 'verified', 'skills', 'message', 'status', 'createdAt', 'resumeLink', 'resumeFile', 'resumeName', 'resumeType', 'education', 'experience'])
        // Resume: a file kept in the application (small), a link, and two short text boxes.
        && incoming().get('resumeLink', '') is string && incoming().get('resumeLink', '').size() <= 300
        && (incoming().get('resumeLink', '') == '' || incoming().get('resumeLink', '').matches('^https?://[^ ]+$'))
        && incoming().get('resumeFile', '') is string && incoming().get('resumeFile', '').size() <= 700000
        && incoming().get('resumeName', '') is string && incoming().get('resumeName', '').size() <= 100
        && incoming().get('resumeType', '') is string && incoming().get('resumeType', '').size() <= 40
        && incoming().get('education', '') is string && incoming().get('education', '').size() <= 400
        && incoming().get('experience', '') is string && incoming().get('experience', '').size() <= 600
        && (!get(/databases/$(database)/documents/openings/$(incoming().openingId)).data.get('resumeRequired', false)
            || incoming().get('resumeFile', '') != '' || incoming().get('resumeLink', '') != '' || incoming().get('experience', '') != '')
        && incoming().message is string && incoming().message.size() <= 500
        && incoming().skills is list && incoming().skills.size() <= 10
        && incoming().employerId != request.auth.uid
        && get(/databases/$(database)/documents/openings/$(incoming().openingId)).data.status == 'approved'
        && get(/databases/$(database)/documents/openings/$(incoming().openingId)).data.state == 'open'
        && get(/databases/$(database)/documents/openings/$(incoming().openingId)).data.applyMode == 'website'
        && get(/databases/$(database)/documents/openings/$(incoming().openingId)).data.posterId == incoming().employerId;
      // The employer moves the application along; nothing else about it can change.
      allow update: if (signedIn() && existing().employerId == request.auth.uid && changedOnly(['status'])
          && incoming().status in ['new', 'interview', 'hired', 'rejected'])
        || isOfficer();
      // The applicant can withdraw.
      allow delete: if (signedIn() && existing().applicantId == request.auth.uid) || isOfficer();
    }

    // ---------- skills (Skills Directory) ----------
    match /skills/{skillId} {
      // Names and phone numbers: signed-in people only.
      allow read: if signedIn();
      // `skill` may be any text the resident wrote (e.g. "Welder", "Gumagawa ng pugon").
      allow create: if notSuspended()
        && incoming().userId == request.auth.uid
        && isNonEmptyString(incoming().name, 120)
        && isNonEmptyString(incoming().skill, 40)
        && validPurok(incoming().purok);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && existing().userId == request.auth.uid);
    }

    // ---------- lostFound ----------
    match /lostFound/{itemId} {
      allow read: if signedIn();
      allow create: if notSuspended()
        && incoming().userId == request.auth.uid
        && incoming().type in ['nawawala', 'nakita']
        && incoming().status == 'open'
        && isNonEmptyString(incoming().item, 120)
        && optionalPhoto();
      // Owner can only mark as "nakabalik".
      allow update: if isAdmin()
        || (signedIn() && existing().userId == request.auth.uid
            && changedOnly(['status'])
            && incoming().status in ['open', 'nakabalik']);
      allow delete: if isAdmin() || (signedIn() && existing().userId == request.auth.uid);
    }

    // ---------- ayuda (Ayuda Checker) ----------
    match /ayuda/{ayudaId} {
      // Lookup by doc id (control number) is allowed for everyone.
      allow get: if true;
      // Name search allowed but capped so nobody can dump the whole list.
      allow list: if isAdmin() || request.query.limit <= 5;
      allow write: if isAdmin();
    }

    // ---------- ayudaBatches: a release of ayuda, approved by the steps the Developer set ('ayuda') ----------
    match /ayudaBatches/{batchId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['title', 'program', 'controlNumbers', 'families', 'perFamily', 'date', 'status', 'authorId', 'authorName', 'createdAt'])
        && incoming().authorId == request.auth.uid
        && incoming().authorName == me().fullName
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().title, 120)
        && isNonEmptyString(incoming().program, 80)
        && incoming().controlNumbers is list && incoming().controlNumbers.size() > 0 && incoming().controlNumbers.size() <= 400
        && incoming().families == incoming().controlNumbers.size()
        && incoming().perFamily is int && incoming().perFamily >= 0 && incoming().perFamily <= 10000000
        && isNonEmptyString(incoming().date, 40)
        && incoming().createdAt == request.time;
      allow update: if approvalMove('ayuda') || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- decisions (private, with the amount) and decisionsPublic (what residents see, no amount) ----------
    match /decisions/{decisionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['title', 'kind', 'amount', 'detail', 'status', 'authorId', 'authorName', 'createdAt'])
        && incoming().authorId == request.auth.uid
        && incoming().authorName == me().fullName
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().title, 120)
        && incoming().kind in ['Gastusin', 'Proyekto', 'Patakaran', 'Iba pa']
        && incoming().amount is number && incoming().amount >= 0 && incoming().amount <= 1000000000
        && isNonEmptyString(incoming().detail, 1000)
        && incoming().createdAt == request.time;
      allow update: if approvalMove('des') || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /decisionsPublic/{decisionId} {
      allow read: if true;
      // Published only together with the approval of the same decision, with the same words and no amount.
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['title', 'kind', 'detail', 'decidedAt'])
        && getAfter(/databases/$(database)/documents/decisions/$(decisionId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/decisions/$(decisionId)).data.title == incoming().title
        && getAfter(/databases/$(database)/documents/decisions/$(decisionId)).data.kind == incoming().kind
        && getAfter(/databases/$(database)/documents/decisions/$(decisionId)).data.detail == incoming().detail
        && incoming().decidedAt == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // ---------- appointments ----------
    match /appointments/{apptId} {
      allow read: if isAdmin() || (signedIn() && existing().userId == request.auth.uid);
      allow create: if verifiedPoster()
        && incoming().userId == request.auth.uid
        && incoming().status == 'natanggap'
        // A listed service, or the one the resident wrote when choosing "Iba pa".
        && isNonEmptyString(incoming()['service'], 60)
        && isNonEmptyString(incoming().fullName, 120);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && existing().userId == request.auth.uid && existing().status == 'natanggap');
    }

    // ---------- registrations (Magparehistro: Ayuda/Clean-up/Fiesta/Event) ----------
    match /registrations/{regId} {
      allow read: if isAdmin() || (signedIn() && existing().userId == request.auth.uid);
      allow create: if notSuspended()
        && incoming().userId == request.auth.uid
        && incoming().purpose in ['Ayuda', 'Clean-up', 'Fiesta', 'Event']
        && validPurok(incoming().purok);
      allow update, delete: if isAdmin();
    }

    // ---------- ambulanceRequests (private: owner + admin) ----------
    match /ambulanceRequests/{reqId} {
      allow read: if isAdmin() || (signedIn() && existing().userId == request.auth.uid);
      // Emergency is never blocked (even unverified/suspended). Scheduling needs verification.
      allow create: if signedIn()
        && (incoming().type == 'emergency' || verifiedPoster())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().type in ['emergency', 'schedule']
        && isNonEmptyString(incoming().patientName, 120)
        && isNonEmptyString(incoming().contact, 40)
        && isNonEmptyString(incoming().pickup, 200)
        && incoming().date is string && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().time is string && incoming().time.matches('^[0-9]{2}:[0-9]{2}$');
      // Secretary -> Admin -> Kapitan decide (approvalMove); a resident may only cancel their own pending request.
      allow update: if (existing().status != 'pending' && isKapitan() && trailUntouched())
        || approvalMove(existing().type == 'emergency' ? 'ambe' : 'amb')
        || isSuperAdmin()
        || (signedIn()
          && existing().userId == request.auth.uid
          && existing().status == 'pending'
          && incoming().status == 'cancelled'
          && changedOnly(['status', 'updatedAt']));
      allow delete: if isKapitan();
    }

    // ---------- ambulanceSchedule (public busy windows, no patient data) ----------
    match /ambulanceSchedule/{slotId} {
      allow read: if true;
      // Public busy window. Whoever releases a request (as set by the Developer) writes it.
      allow write: if isAdmin();
    }

    // ---------- polls (Botohan) ----------
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // One vote per resident: uid is appended to "voters" exactly once.
      allow update: if isAdmin()
        || (verifiedPoster()
          && existing().isActive == true
          && changedOnly(['votes', 'voters'])
          && !(request.auth.uid in existing().voters)
          && request.auth.uid in incoming().voters
          && incoming().voters.size() == existing().voters.size() + 1
          && incoming().voters.hasAll(existing().voters)
          && incoming().votes.size() == existing().votes.size() + 1
          && incoming().votes.hasAll(existing().votes));
    }

    // ---------- projects (transparency) + full-size before/after photos ----------
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projectPhotos/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- events ----------
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- purokPoints ----------
    match /purokPoints/{purokId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Blotter / Reklamo (private: complainant + officers) ----------
    match /blotters/{id} {
      allow read: if (signedIn() && resource.data.complainantId == request.auth.uid) || isOfficer();
      allow create: if verifiedPoster()
        && incoming().complainantId == request.auth.uid
        && incoming().status == 'natanggap'
        && incoming().keys().hasOnly(['caseNo', 'complainantId', 'complainantName', 'purok', 'contact', 'type', 'description', 'respondent', 'hasPhoto', 'status', 'history', 'createdAt'])
        && isNonEmptyString(incoming().description, 2000)
        && incoming().type is string && incoming().type.size() <= 60
        && incoming().respondent is string && incoming().respondent.size() <= 120
        && incoming().history is list && incoming().history.size() == 1;
      allow update: if isOfficer();
      allow delete: if isSuperAdmin();
    }
    // Evidence photo kept apart (same privacy as its blotter).
    match /blotterPhotos/{id} {
      allow read: if isOfficer()
        || (signedIn() && get(/databases/$(database)/documents/blotters/$(id)).data.complainantId == request.auth.uid);
      allow create: if verifiedPoster()
        && getAfter(/databases/$(database)/documents/blotters/$(id)).data.complainantId == request.auth.uid
        && incoming().photo is string && incoming().photo.size() < 400000;
      allow update: if false;
      allow delete: if isOfficer();
    }

    // ---------- Senior / PWD / Solo Parent registry (officers; a linked resident sees their own) ----------
    match /sectorMembers/{id} {
      allow read: if isOfficer() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isOfficer()
        && isNonEmptyString(incoming().fullName, 120)
        && incoming().sectors is list && incoming().sectors.size() > 0 && incoming().sectors.size() <= 3;
      allow delete: if isOfficer();
    }

    // ---------- Kalusugan: children's vaccines + pregnancies (BHW; parent/mother sees own) ----------
    match /children/{id} {
      allow read: if isBotika() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, update: if isBotika()
        && isNonEmptyString(incoming().name, 120)
        && incoming().birthday is string && incoming().birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && incoming().vaccines is map;
      allow delete: if isBotika();
    }
    match /pregnancies/{id} {
      allow read: if isBotika() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isBotika() && isNonEmptyString(incoming().name, 120);
      allow delete: if isBotika();
    }

    // ---------- Liga at Palaro (public; officers + SK Chairman manage) ----------
    match /leagues/{id} {
      allow read: if true;
      allow write: if isLiga();
    }
    match /ligaGames/{id} {
      allow read: if true;
      allow create, update: if isLiga()
        && incoming().homeScore is int && incoming().homeScore >= 0
        && incoming().awayScore is int && incoming().awayScore >= 0
        && incoming().status in ['scheduled', 'live', 'final'];
      allow delete: if isLiga();
    }
    match /ligaTeams/{id} {
      allow read: if true;
      // Verified residents register a team; it waits for approval.
      allow create: if verifiedPoster()
        && incoming().captainId == request.auth.uid
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().name, 60)
        && incoming().players is list && incoming().players.size() <= 20;
      allow update: if isLiga();
      allow delete: if isLiga()
        || (signedIn() && resource.data.captainId == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------- Pabatid (announcements) ----------
    match /announcements/{id} {
      allow read: if true;
      // BHW may also send "Kalusugan" notices (vaccination reminders).
      allow create, update: if (isOfficer() || (isBotika() && incoming().category == 'Kalusugan'))
        && isNonEmptyString(incoming().title, 120)
        && incoming().body is string && incoming().body.size() <= 2000
        && incoming().category is string && incoming().category.size() <= 30
        && incoming().puroks is list && incoming().puroks.size() <= 50;
      allow delete: if isOfficer();
    }

    // ---------- Survey (anonymous answers, one per verified resident) ----------
    match /surveys/{surveyId} {
      allow read: if true;
      allow create, update: if isOfficer()
        && isNonEmptyString(incoming().title, 150)
        && incoming().questions is list && incoming().questions.size() > 0 && incoming().questions.size() <= 10
        && incoming().status in ['open', 'closed'];
      allow delete: if isOfficer();

      // voters/{uid} only marks THAT you answered; the answers are stored without your uid.
      match /voters/{uid} {
        allow get: if isSelf(uid) || isOfficer();
        allow list: if isOfficer();
        allow create: if isSelf(uid) && verifiedPoster()
          && get(/databases/$(database)/documents/surveys/$(surveyId)).data.status == 'open'
          && incoming().keys().hasOnly(['at']);
        allow update, delete: if false;
      }
    }

    match /surveyResponses/{id} {
      allow read: if isOfficer();
      // Only together with a NEW voters/{me} marker in the same batch = one answer per person.
      allow create: if verifiedPoster()
        && incoming().keys().hasOnly(['surveyId', 'answers', 'suggestion'])
        && incoming().answers is list && incoming().answers.size() <= 10
        && incoming().suggestion is string && incoming().suggestion.size() <= 500
        && get(/databases/$(database)/documents/surveys/$(incoming().surveyId)).data.status == 'open'
        && !exists(/databases/$(database)/documents/surveys/$(incoming().surveyId)/voters/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/surveys/$(incoming().surveyId)/voters/$(request.auth.uid));
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Suhestiyon box: anonymous (no uid stored), verified residents only.
    match /suggestions/{id} {
      allow read, delete: if isOfficer();
      allow create: if verifiedPoster()
        && incoming().keys().hasOnly(['text', 'purok', 'createdAt'])
        && isNonEmptyString(incoming().text, 1000)
        && incoming().purok is string && incoming().purok.size() <= 40;
      allow update: if false;
    }

    // ---------- Transparency (budget and expenses; public) ----------
    match /budgets/{year} {
      allow read: if true;
      allow write: if isOfficer()
        && incoming().total is number && incoming().total >= 0
        && incoming().categories is list && incoming().categories.size() <= 20;
    }
    match /expenses/{id} {
      allow read: if true;
      allow create, update: if isOfficer()
        && isNonEmptyString(incoming().description, 200)
        && incoming().amount is number && incoming().amount >= 0
        && incoming().year is int
        && incoming().category is string && incoming().category.size() <= 60;
      allow delete: if isOfficer();
    }
    // Receipt photos live apart so the expense list stays light.
    match /expenseReceipts/{id} {
      allow read: if true;
      allow write: if isOfficer() && incoming().photo is string && incoming().photo.size() < 400000;
      allow delete: if isOfficer();
    }

    // ---------- Mapa (places pinned on the Malineng map) ----------
    function validPlace() {
      return isNonEmptyString(incoming().name, 80)
        && incoming().category is string && incoming().category.size() <= 40
        && incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90
        && incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180
        && incoming().photo is string && incoming().photo.size() < 150000
        && incoming().description is string && incoming().description.size() <= 300;
    }

    match /places/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      // Verified residents submit for approval; evacuation centers are admin-only.
      allow create: if validPlace() && (
        isAdmin()
        || (verifiedPoster()
          && incoming().ownerId == request.auth.uid
          && incoming().status == 'pending'
          && incoming().category != 'Evacuation Center'));
      // Owners may edit their own pin; it goes back to "pending" for review.
      allow update: if isAdmin()
        || (verifiedPoster() && validPlace()
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().status == 'pending'
          && incoming().category != 'Evacuation Center');
      allow delete: if isAdmin() || (signedIn() && existing().ownerId == request.auth.uid);
    }

    // ---------- who is online (logged-in users; Super Admin only) ----------
    match /presenceUsers/{uid} {
      allow read: if isSuperAdmin();
      // `devices`: ids of phones this account was used on (for the duplicate checker).
      allow create, update: if isSelf(uid)
        && incoming().keys().hasOnly(['lastSeen', 'devices'])
        && incoming().lastSeen == request.time
        && (!('devices' in incoming()) || (incoming().devices is list && incoming().devices.size() <= 20));
      allow delete: if isSuperAdmin();
    }

    // ---------- presence ("online now" counter) ----------
    // Any visitor (even a guest) marks their device as seen. Only a server
    // timestamp is stored, so there is nothing private to read.
    match /presence/{deviceId} {
      allow read: if true;
      allow create, update: if deviceId.matches('^[a-z0-9]{20}$')
        && incoming().keys().hasOnly(['lastSeen'])
        && incoming().lastSeen == request.time;
      allow delete: if isSuperAdmin();
    }

    // ---------- stats (public counts only; written by admins) ----------
    match /stats/{docId} {
      allow read: if true;
      // Officers publish this week's senior birthdays (first name + age only) for the Home greeting.
      allow write: if isAdmin() || (docId == 'birthdays' && isOfficer());
    }

    // ---------- settings (settings/main; settings/webAccess is Super Admin only) ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if docId in ['webAccess', 'chat', 'approvals'] ? isSuperAdmin() : isAdmin();
    }

    // ---------- Chat ng Barangay (verified residents) ----------
    match /chatRooms/{room} {
      // Room settings: the pinned message.
      allow read: if canReadRoom(room);
      allow write: if isOfficer() && incoming().keys().hasOnly(['pinText', 'pinBy', 'pinAt'])
        && incoming().pinText is string && incoming().pinText.size() <= 300
        && incoming().pinBy is string && incoming().pinBy.size() <= 80;

      match /messages/{messageId} {
        allow read: if canReadRoom(room);
        allow create: if canReadRoom(room) && chatOpen() && !chatMuted()
          && incoming().keys().hasOnly(['text', 'photo', 'authorId', 'authorName', 'authorRole', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && incoming().authorName == me().fullName
          // The badge must be the sender's real position: nobody can pose as Kapitan.
          && (incoming().authorRole == ''
              || (isAdmin() && incoming().authorRole == me().get('position', ''))
              || (isSuperAdmin() && incoming().authorRole == 'Super Admin'))
          && incoming().text is string && incoming().text.size() <= 500
          // A video-call message is a random Jitsi room name. Only officers start one, only in the
          // private staff rooms, and nothing else may carry the marker.
          && (!incoming().text.matches('(?s).*\\[\\[call:.*')
              || (isOfficer() && room in ['staff-admin', 'staff-officials']
                  && incoming().text.matches('^\\[\\[call:Malineng-[A-Za-z0-9]{16}\\]\\]$') && incoming().photo == ''))
          && incoming().photo is string && incoming().photo.size() <= 200000
          && (incoming().photo == '' || chatPhotosOpen())
          && (incoming().text.size() > 0 || incoming().photo.size() > 0)
          && incoming().createdAt == request.time;
        // Officers remove anything; the writer may remove their own message for 5 minutes.
        allow delete: if isOfficer()
          || (signedIn() && existing().authorId == request.auth.uid && request.time < existing().createdAt + duration.value(5, 'm'));
      }
    }

    // "Nagta-type..." marks: one tiny document per person per room, written at most every few
    // seconds while typing and deleted on send. Only the owner writes it, with the server time.
    match /chatRooms/{room}/typing/{uid} {
      allow read: if canReadRoom(room);
      allow create, update: if isSelf(uid) && canReadRoom(room) && chatOpen() && !chatMuted()
        && incoming().keys().hasOnly(['name', 'at'])
        && incoming().name == me().fullName
        && incoming().at == request.time;
      allow delete: if isSelf(uid);
    }

    // Temporary mutes set by officers.
    match /chatMutes/{uid} {
      allow read: if isSelf(uid) || isOfficer();
      allow create, update: if isOfficer()
        && incoming().keys().hasOnly(['until', 'by', 'name', 'reason'])
        && incoming().until is timestamp
        && incoming().by is string && incoming().name is string && incoming().name.size() <= 80
        && incoming().reason is string && incoming().reason.size() <= 120;
      allow delete: if isOfficer();
    }

    // Reports from residents. Document id = messageId_reporterUid, so one report per person per message.
    match /chatReports/{reportId} {
      allow read: if isOfficer();
      allow create: if verifiedPoster()
        && incoming().keys().hasOnly(['room', 'messageId', 'messageText', 'messageAuthorId', 'messageAuthorName', 'reporterId', 'reason', 'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && reportId == incoming().messageId + '_' + request.auth.uid
        && canReadRoom(incoming().room)
        && incoming().messageText is string && incoming().messageText.size() <= 500
        && isNonEmptyString(incoming().reason, 60)
        && incoming().status == 'open'
        && incoming().createdAt == request.time;
      allow update: if isOfficer() && changedOnly(['status']) && incoming().status in ['open', 'removed', 'dismissed'];
      allow delete: if isOfficer();
    }

    // ---------- Home videos (links only; no file storage) ----------
    match /videos/{videoId} {
      allow read: if true;
      // Everything about videos (links, uploads, hide, delete) belongs to the Super Admin.
      allow create: if isSuperAdmin()
        && incoming().keys().hasOnly(['title', 'url', 'kind', 'videoId', 'order', 'views', 'hidden', 'chunks', 'mime', 'size', 'thumb', 'createdAt'])
        && isNonEmptyString(incoming().title, 100)
        && incoming().order is number
        && incoming().views == 0
        && incoming().get('hidden', false) is bool
        && incoming().createdAt == request.time
        && (
          (incoming().kind in ['youtube', 'facebook', 'file']
            && isNonEmptyString(incoming().url, 500)
            && incoming().videoId is string && incoming().videoId.size() <= 20)
          || (incoming().kind == 'upload'
            && incoming().url == '' && incoming().videoId == ''
            && incoming().chunks is int && incoming().chunks >= 1 && incoming().chunks <= 30
            && isNonEmptyString(incoming().mime, 60)
            && incoming().size is int && incoming().size > 0 && incoming().size <= 14000000
            && incoming().thumb is string && incoming().thumb.size() <= 60000)
        );
      allow update: if (isSuperAdmin() && changedOnly(['title', 'order', 'hidden'])
          && isNonEmptyString(incoming().title, 100)
          && incoming().get('hidden', false) is bool)
        || (isSuperAdmin() && existing().kind != 'upload' && changedOnly(['title', 'url', 'kind', 'videoId', 'order'])
          && isNonEmptyString(incoming().title, 100)
          && isNonEmptyString(incoming().url, 500)
          && incoming().kind in ['youtube', 'facebook', 'file']
          && incoming().videoId is string && incoming().videoId.size() <= 20)
        // Anyone watching adds exactly one view.
        || (changedOnly(['views']) && incoming().views == existing().views + 1)
        // Signed-in residents react: only their own uid in "likes" and "reactions".
        || (signedIn() && notSuspended()
          && changedOnly(['likes', 'reactions'])
          && incoming().get('likes', []).toSet().difference(existing().get('likes', []).toSet())
               .union(existing().get('likes', []).toSet().difference(incoming().get('likes', []).toSet()))
               .hasOnly([request.auth.uid])
          && incoming().get('reactions', {}).diff(existing().get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in incoming().get('reactions', {}))
              || incoming().reactions[request.auth.uid] in ['like', 'love', 'haha', 'wow', 'sad', 'pray']));
      allow delete: if isSuperAdmin();

      // Pieces of an uploaded video (about 700 KB each).
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isSuperAdmin()
          && incoming().keys().hasOnly(['n', 'data'])
          && incoming().n is int
          && incoming().data is bytes && incoming().data.size() <= 800000;
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- Comments under Home videos ----------
    match /videoComments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && notSuspended() && !chatMuted()
        && incoming().keys().hasOnly(['videoId', 'authorId', 'authorName', 'text', 'createdAt'])
        && incoming().authorId == request.auth.uid
        && incoming().authorName == me().fullName
        && isNonEmptyString(incoming().text, 1000)
        && exists(/databases/$(database)/documents/videos/$(incoming().videoId))
        && incoming().createdAt == request.time;
      allow update: if false;
      // Officers remove any comment; the writer removes their own.
      allow delete: if isOfficer() || (signedIn() && existing().authorId == request.auth.uid);
    }

    // Reports on those comments. Document id = commentId_reporterUid (one report per person per comment).
    match /videoCommentReports/{reportId} {
      allow read: if isOfficer();
      allow create: if signedIn() && notSuspended()
        && incoming().keys().hasOnly(['videoId', 'commentId', 'commentText', 'commentAuthorId', 'commentAuthorName', 'reporterId', 'reason', 'status', 'createdAt'])
        && incoming().reporterId == request.auth.uid
        && reportId == incoming().commentId + '_' + request.auth.uid
        && incoming().commentText is string && incoming().commentText.size() <= 1000
        && isNonEmptyString(incoming().reason, 60)
        && incoming().status == 'open'
        && incoming().createdAt == request.time;
      allow update: if isOfficer() && changedOnly(['status']) && incoming().status in ['open', 'removed', 'dismissed'];
      allow delete: if isOfficer();
    }

    // ---------- Presinto Finder (Posted Computerized Voters List) ----------
    // Private list: only signed-in, non-suspended residents may search, and a query may return
    // at most 20 documents, so the whole list cannot be downloaded in one go.
    match /precinctVoters/{voterId} {
      allow get: if isOfficer();
      allow list: if isOfficer()
        || (signedIn() && notSuspended() && request.query.limit <= 20);
      // Kapitan, Secretary and Super Admin upload; only the Super Admin may wipe the list.
      allow create, update: if isOfficer()
        && incoming().keys().hasOnly(['name', 'nameKey', 'address', 'precinct', 'remarks', 'createdAt'])
        && isNonEmptyString(incoming().name, 120)
        && isNonEmptyString(incoming().nameKey, 120)
        && incoming().address is string && incoming().address.size() <= 200
        && isNonEmptyString(incoming().precinct, 8)
        && incoming().remarks is string && incoming().remarks.size() <= 30
        && incoming().createdAt == request.time;
      allow delete: if isSuperAdmin();
    }

    // Election date, polling places and list size (not sensitive, shown on Home).
    match /precinctMeta/{docId} {
      allow read: if true;
      allow write: if isOfficer() && docId == 'current'
        && incoming().keys().hasOnly(['count', 'precincts', 'electionDate', 'electionName', 'defaultPlace', 'places', 'listDate', 'uploadedAt'])
        && incoming().count is int && incoming().count >= 0
        && incoming().precincts is list && incoming().precincts.size() <= 200
        && incoming().electionDate is string && incoming().electionDate.size() <= 80
        && incoming().electionName is string && incoming().electionName.size() <= 120
        && incoming().defaultPlace is string && incoming().defaultPlace.size() <= 160
        && incoming().places is map
        && incoming().listDate is string && incoming().listDate.size() <= 80;
      allow delete: if isSuperAdmin();
    }

    // Anonymous search counters: a search can only add exactly 1 to the right counters.
    match /precinctStats/{docId} {
      allow read: if isOfficer();
      allow create: if isOfficer() && docId == 'current'
        && incoming().keys().hasOnly(['searches', 'found', 'notFound'])
        && incoming().searches == 0 && incoming().found == 0 && incoming().notFound == 0;
      allow delete: if isSuperAdmin() && docId == 'current';
      allow update: if docId == 'current' && (
        isSuperAdmin()
        || (signedIn() && notSuspended() && changedOnly(['searches', 'found', 'notFound'])
            && incoming().searches == existing().searches + 1
            && ((incoming().found == existing().found + 1 && incoming().notFound == existing().notFound)
                || (incoming().notFound == existing().notFound + 1 && incoming().found == existing().found)))
      );
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
